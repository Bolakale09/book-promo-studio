# Streamlit Community Cloud: paste this (with your real values) into the app's Settings > Secrets.
# Never commit the real file.
APP_PASSWORD = "choose-a-strong-password"
OPENAI_API_KEY = ""
XAI_API_KEY = "xai-..."
PEXELS_API_KEY = ""
MONTHLY_BUDGET_USD = "20"

# Use xAI (Grok) for everything: scripts, AI photos, narration voice, AI video
LLM_PROVIDER = "xai"
IMAGE_PROVIDER = "xai"
TTS_PROVIDER = "xai"
VIDEO_PROVIDER = "xai"

# Cloudflare R2: keeps your books, scripts and videos when the app sleeps/restarts (free up to 10 GB)
R2_ACCOUNT_ID = "your-cloudflare-account-id"
R2_ACCESS_KEY_ID = "..."
R2_SECRET_ACCESS_KEY = "..."
R2_BUCKET = "book-promo-studio"
