<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so the app can reach the studio running on your PC over Wi-Fi
     (e.g. http://192.168.1.20:8501). The web version on streamlit.app always uses https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
