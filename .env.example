# Copy this file to .env (or just fill the keys in the app's sidebar - it writes .env for you)
OPENAI_API_KEY=
XAI_API_KEY=
# Free at https://www.pexels.com/api/ - realistic stock footage at $0
PEXELS_API_KEY=

MONTHLY_BUDGET_USD=20

# openai (gpt-5-mini, cheapest) or xai (Grok)
LLM_PROVIDER=openai
# openai (gpt-image-1-mini) or xai (grok-imagine-image)
IMAGE_PROVIDER=openai
IMAGE_QUALITY=medium
# xai (grok-imagine-video, cheapest) or openai (sora-2)
VIDEO_PROVIDER=xai
